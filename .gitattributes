# Auto-detect text files and normalize line endings
* text=auto

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Batch files must always use CRLF line endings
*.bat text eol=crlf

# Python source files
*.py text eol=lf

# Markdown and config files
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
